---
import type { Locale } from '@/i18n'
import {
  downloadGroups,
  type DownloadGroup,
  type ResolvedDownload
} from '@/downloads'
import { messages } from '@/i18n'

interface Props {
  locale: Locale
  downloads: ResolvedDownload[]
  recommendedId: string
}

const { locale, downloads, recommendedId } = Astro.props
const labels = messages[locale].downloadSection

function formatVersion(version: string): string {
  return version.toLowerCase().startsWith('v') ? version : `v${version}`
}
---

<section id="download" class="download-band">
  <div class="download-inner">
    <div class="download-heading">
      <p class="eyebrow">{labels.eyebrow}</p>
      <h2>{labels.title}</h2>
      <p>{labels.intro}</p>
    </div>

    <div class="download-platforms" data-download-platforms>
      {
        downloadGroups.map((group: DownloadGroup) => {
          const groupDownloads = downloads.filter((download) => download.group === group)
          if (!groupDownloads.length) return null
          return (
            <article class="download-platform" data-download-group={group}>
              <h3 class="download-platform-title">
                {group === 'macos' ? (
                  <svg class="platform-mark platform-mark--mac" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
                  </svg>
                ) : (
                  <svg class="platform-mark platform-mark--windows" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="2" y="2" width="9" height="9" fill="#f25022" />
                    <rect x="13" y="2" width="9" height="9" fill="#7fba00" />
                    <rect x="2" y="13" width="9" height="9" fill="#00a4ef" />
                    <rect x="13" y="13" width="9" height="9" fill="#ffb900" />
                  </svg>
                )}
                {labels.groups[group]}
              </h3>
              <div class="download-list">
                {
                  groupDownloads.map((download) => (
                    <a
                      class:list={['download-card', { 'download-card-recommended': download.id === recommendedId }]}
                      href={download.href}
                      download
                      rel="noopener noreferrer"
                      data-download-platform={download.id}
                      aria-label={`${labels.download} ${download.label}`}
                    >
                      <span class="download-card-main">
                        <strong>{download.label}</strong>
                        <span class="download-extension">{download.extension}</span>
                        <span class="download-recommended" data-recommended-badge hidden={download.id !== recommendedId}>
                          {labels.recommended}
                        </span>
                      </span>
                      <span class="download-card-meta">
                        <span data-platform-version>{formatVersion(download.version)}</span>
                        <small data-platform-file>{download.fileName}</small>
                      </span>
                    </a>
                  ))
                }
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>