# Public DNS names. Both records must point to this Docker host.
LOCKPASS_DOMAIN=lockpass.example.com
LOCKPASS_ADMIN_DOMAIN=admin.lockpass.example.com

# Use URL-safe characters because this value is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Created only when the database contains no accounts.
LOCKPASS_ADMIN_USERNAME=admin
LOCKPASS_ADMIN_PASSWORD=replace-with-a-long-admin-password

# Change these only when another reverse proxy already occupies ports 80/443.
HTTP_PORT=80
HTTPS_PORT=443

LOCKPASS_RUST_LOG=lockpass_sync_server=info,tower_http=info
