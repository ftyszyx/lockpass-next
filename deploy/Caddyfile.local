http://:80 {
	encode zstd gzip

	@api path /health /auth/* /devices/* /sync/* /console/* /admin/*
	handle @api {
		reverse_proxy server:8080
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

http://:8081 {
	encode zstd gzip

	root * /srv/admin_web
	try_files {path} /index.html
	file_server
}
