LOCKPASS_SERVER_ADDR=127.0.0.1:1480
DATABASE_URL=postgres://lockpass:lockpass@127.0.0.1:5432/lockpass

# Comma-separated allowed origins for web, admin web, desktop dev, and Tauri.
LOCKPASS_CORS_ORIGIN=http://127.0.0.1:1431,http://127.0.0.1:1432,http://127.0.0.1:1430,http://tauri.localhost

# Email verification delivery is configured in the admin console.
# The default instance config uses development log mode until an admin switches
# it to SMTP.

# Used by docker compose.
SERVER_PORT=1480
