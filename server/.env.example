# 服务器地址和端口
LOCKPASS_SERVER_ADDR=127.0.0.1:8080

# 数据库
DATABASE_URL=postgres://lockpass:lockpass@127.0.0.1:5432/lockpass


# https://admin.lockpass.cn：给 Web 后台用
# http://tauri.localhost：给打包后的 Tauri 桌面端用
# http://127.0.0.1:1430：给本地 tauri dev / Vite 预览用
# CORS 允许的来源，多个用逗号分隔。正式环境需要同时放行 Web 后台域名和桌面端 Tauri 来源。
LOCKPASS_CORS_ORIGIN='https://admin.lockpass.cn,http://tauri.localhost,http://127.0.0.1:1430'
# 线上示例：
# LOCKPASS_CORS_ORIGIN='https://admin.lockpass.cn,http://tauri.localhost'

# docker compose 使用
SERVER_PORT=8080
