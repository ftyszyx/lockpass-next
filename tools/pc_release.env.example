# Updater signing key. The private key must stay local or in CI secrets.
LOCKPASS_SIGNING_KEY_PATH=%USERPROFILE%\.tauri\lockpass.key

# Aliyun OSS credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=

# Public URL base. If omitted, the script uses https://<bucket>.<endpoint>.
OSS_PUBLIC_BASE_URL=

# Object keys:
# - installer/signature: <OSS_ASSET_PREFIX>/<file>
# - latest.json: <OSS_LATEST_KEY>
OSS_PREFIX=desktop
OSS_ASSET_PREFIX=desktop/windows
OSS_LATEST_KEY=desktop/latest.json
OSS_PUBLIC_READ=true

# Optional release notes used in latest.json.
RELEASE_NOTES=
