# LockPass Windows release config.

# Tauri updater signing keys. Keep the private key out of the repository.
# CI can set key contents directly. Local releases should usually set both paths below.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PUBLIC_KEY=
LOCKPASS_SIGNING_PRIVATE_KEY_PATH=tools/keys/lockpass.key
LOCKPASS_SIGNING_PUBLIC_KEY_PATH=tools/keys/lockpass.key.pub

# Desktop build-time official server URLs.
VITE_LOCKPASS_OFFICIAL_SERVER_URL=http://127.0.0.1:1431
VITE_LOCKPASS_OFFICIAL_API_URL=http://127.0.0.1:1480

# Aliyun OSS credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=

# Public URL base. If omitted, the script uses https://<bucket>.<endpoint>.
OSS_PUBLIC_BASE_URL=

# Object keys:
# - installer/signature: <OSS_APPS_DIR>/<Tauri identifier>/<channel>/<platform>/<file>
# - latest.json: <OSS_APPS_DIR>/<Tauri identifier>/<channel>/<platform>/latest.json
# Existing OSS objects are overwritten by default.
OSS_APPS_DIR=apps
OSS_PUBLIC_READ=true

# Release version tag and optional notes used in latest.json.
RELEASE_TAG=v0.1.3
RELEASE_NOTES=
