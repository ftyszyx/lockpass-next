# LockPass Windows release config.

# Tauri updater signing private key.
# You can also provide TAURI_SIGNING_PRIVATE_KEY directly in the environment.
LOCKPASS_SIGNING_KEY_PATH=.\keys\lockpass.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Desktop build-time official server URLs.
VITE_LOCKPASS_OFFICIAL_SERVER_URL=http://127.0.0.1:1431
VITE_LOCKPASS_OFFICIAL_API_URL=http://127.0.0.1:1480

# Aliyun OSS credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=

# Public URL base. If omitted, the script uses https://<bucket>.<endpoint>.
OSS_PUBLIC_BASE_URL=

# Object keys:
# - installer/signature: <OSS_APPS_DIR>/<Tauri identifier>/<channel>/<platform>/<file>
# - latest.json: <OSS_APPS_DIR>/<Tauri identifier>/<channel>/<platform>/latest.json
# Existing OSS objects are overwritten by default.
OSS_APPS_DIR=apps
OSS_PUBLIC_READ=true

# Optional release notes used in latest.json.
RELEASE_NOTES=
