{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/bower_components": true,
			"**/*.code-search": true
		},
		"files.watcherExclude": {
			".git/objects/**": true,
			".git/subtree-cache/**": true,
			".hg/store/**": true,
			"*/.git/objects/**": true,
			"*/.git/subtree-cache/**": true,
			"*/.hg/store/**": true
		}
	}
}