# Production HTTPS deployment. Both hostnames must resolve to this Docker host.
LOCKPASS_DEPLOY_MODE=production
LOCKPASS_PUBLIC_URL=https://lockpass.example.com
LOCKPASS_ADMIN_URL=https://admin.lockpass.example.com

# PostgreSQL. Keep POSTGRES_HOST=postgres for the bundled database service.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=lockpass
POSTGRES_USER=lockpass
# Use URL-safe characters because this value is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Created only when the database contains no accounts.
LOCKPASS_ADMIN_USERNAME=admin
LOCKPASS_ADMIN_PASSWORD=change-me

# Caddy uses these ports for certificate issuance and HTTPS traffic.
HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_BIND_ADDRESS=0.0.0.0

# The local-only admin port is unused in production mode.
ADMIN_HTTP_PORT=8081
ADMIN_BIND_ADDRESS=127.0.0.1

LOCKPASS_RUST_LOG=lockpass_sync_server=info,tower_http=info
